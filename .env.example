# PostgreSQL container used for local development only.
POSTGRES_DB=culinary_blog_dev
POSTGRES_USER=culinary_blog
POSTGRES_PASSWORD=culinary_blog_dev
POSTGRES_PORT=5432

# pgAdmin web interface
PGADMIN_DEFAULT_EMAIL=admin@culinaryblog.com
PGADMIN_DEFAULT_PASSWORD=culinary_blog_admin
PGADMIN_PORT=5050

# MinIO Object Storage (FR-FILE-001, FR-FILE-002)
MINIO_ROOT_USER=culinary_minio_admin
MINIO_ROOT_PASSWORD=culinary_minio_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# Backend .NET (CulinaryBlog.API)
# ASP.NET Core KHONG tu doc file .env: dat cac bien duoi day lam bien moi truong
# (PowerShell: $env:JwtSettings__Secret="..."), trong launchSettings.json, hoac dung
# `dotnet user-secrets` (dau ":" doi thanh "__"). Gia tri o day chi la mau cho Development.
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=culinary_blog_dev;Username=culinary_blog;Password=culinary_blog_dev

# MinIO Object Storage Settings
Minio__Enabled=true
Minio__Endpoint=http://localhost:9000
Minio__PublicUrl=http://localhost:9000
Minio__AccessKey=culinary_minio_admin
Minio__SecretKey=culinary_minio_secret
Minio__BucketName=culinary-blog
Minio__Region=us-east-1
Minio__ForcePathStyle=true

# JWT (NFR-SEC: khoa ky lay tu secret store, toi thieu 32 ky tu, KHONG commit gia tri that)
JwtSettings__Secret=
JwtSettings__Issuer=CulinaryBlogApi
JwtSettings__Audience=CulinaryBlogClients
JwtSettings__ExpiryMinutes=15

# Dang nhap Google (FR-AUTH-003): chi can Client ID, KHONG dung Client secret
GoogleAuth__ClientId=

# Link trong email xac nhan tro ve frontend
ClientApp__BaseUrl=http://localhost:3000

# CORS allowlist (SRS 5.2, NFR-SEC): moi origin mot bien, khong dung "*" ngoai Development
Cors__AllowedOrigins__0=http://localhost:3000
