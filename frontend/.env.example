# Goi truc tiep backend tu trinh duyet (lib/api-client.ts, lib/api.ts) - can backend bat CORS cho http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Dia chi backend cho rewrite /api/v1/* trong next.config.ts va cac request phia server (KHONG kem /api/v1)
BACKEND_API_URL=http://localhost:5000

# --- Auth (SRS 5.2: Bearer access token, refresh token trong body) ---
# Google Identity Services: Client ID (khong phai Client secret), trung voi GoogleAuth:ClientId cua backend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Ảnh đại diện (trang /profile): bật nút "Chọn ảnh" khi backend đã có POST /auth/me/avatar (multipart, trường "file").
# Để trống/false: chỉ hiển thị và xoá ảnh hiện có.
NEXT_PUBLIC_AVATAR_UPLOAD_ENABLED=false
