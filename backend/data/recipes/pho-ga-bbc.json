    {
      "title": "Nấu nước dùng",
      "description": "Cho hành tỏi phi, sả, gừng, các loại gia vị, đường, nước mắm, nước dùng gà và ức gà vào nồi lớn, đậy nắp, đun liu riu khoảng 15 phút.",
      "durationMinutes": 15
    },
    {
      "title": "Luộc bún",
      "description": "Trụng bún theo hướng dẫn trên bao bì đến khi vừa chín, xả nước lạnh, để ráo rồi chia vào các tô."
    },
    {
      "title": "Lọc nước dùng",
      "description": "Lọc nước dùng qua rây, bỏ gia vị. Xé nhỏ thịt gà. Đun sôi lại nước dùng và nêm thêm nước mắm nếu cần."
    },
    {
      "title": "Hoàn thiện",
      "description": "Xếp thịt gà lên bún, chan nước dùng nóng, thêm hành lá, cà rốt, giá, rau thơm, ớt, hành phi; ăn kèm chanh và thêm nước mắm, ớt tùy khẩu vị."
    }
